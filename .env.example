# EvercoatITWRD APP — environment template
# =============================================================================
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# In staging/production these values come from SOPS + age encrypted files,
# not from a plaintext .env (SECURITY.md §12).
#
# WRITING THIS FILE ON WINDOWS: PowerShell pipelines add a UTF-16 BOM,
# which makes the first key unparseable in a way that looks exactly like a
# wrong password. Write UTF-8 explicitly:
#     Out-File -Encoding utf8   (not Set-Content, which defaults to ANSI)
# =============================================================================

APP_ENV=development

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=evercoat_itw_rd
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_PORT=55432

# The application connects as evercoat_app, NOT as postgres. The superuser
# bypasses Row Level Security, so running the app as one hides exactly the
# defects RLS exists to catch — and they surface only in production.
# app/core/config.py refuses to start if this looks like the superuser.
APP_DB_USER=evercoat_app
APP_DB_PASSWORD=change-me-app

WORKER_DB_USER=evercoat_worker
WORKER_DB_PASSWORD=change-me-worker

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_PORT=18080
KEYCLOAK_ISSUER=http://keycloak:8080/realms/evercoat
KEYCLOAK_AUDIENCE=evercoat-api

# --- Object storage ----------------------------------------------------------
GARAGE_ENDPOINT=http://garage:3900
GARAGE_BUCKET=evercoat-documents
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# --- Cache / worker ----------------------------------------------------------
VALKEY_URL=redis://valkey:6379/0

# --- Ports -------------------------------------------------------------------
# Deliberately NOT the conventional 5432/8080/3000/80. This host already
# runs the AutoWorkshop stack (aw-postgres on 5432, aw-keycloak on 8080,
# aw-redis 6379, aw-minio 9000-9001, aw-nats 4222/8222, aw-mailpit
# 1025/8025). Binding the usual ports would fail to start at best and
# disrupt a working project at worst. Change these only after checking
# `docker ps` -- never assume a port is free.
API_PORT=18000
WEB_PORT=13000
HTTP_PORT=18081
HTTPS_PORT=18443

# --- Frontend ----------------------------------------------------------------
# NEXT_PUBLIC_* is BUILD-time, not runtime. Changing these after the image
# is built has no effect — they must be build args for a real deployment.
NEXT_PUBLIC_API_URL=http://localhost:18000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:18080

# --- Observability -----------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO
METRICS_ENABLED=true

# --- Security ----------------------------------------------------------------
# Comma-separated. A wildcard is rejected outright when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:13000

# --- AI (Slice 7 onward) -----------------------------------------------------
# Local runtime only. No paid AI API may become essential, and proprietary
# formulations must not leave this infrastructure.
# OLLAMA_MODEL is left empty deliberately: it is chosen from measured
# container memory headroom at the end of Slice 1, not assumed.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
