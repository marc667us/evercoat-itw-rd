node_modules/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.next/
dist/
.venv/
venv/
*.log
.DS_Store

# Next.js
.next/
out/
next-env.d.ts

# Backups contain the entire R&D IP. Never committed.
backups/
*.dump

# Session transcripts are large (~8 MB each) and are archives, not source.
# Kept on disk under docs/sessions/ for handover; not committed.
docs/sessions/*.jsonl

# Playwright: run artifacts, never source. `test-results/` holds traces,
# screenshots and videos of failures; `playwright-report/` is the HTML
# report. Both are regenerated by every run and can be large.
test-results/
playwright-report/
blob-report/
.playwright/

# Build artefacts that were being tracked or left dirty after a session.
#
# `tsconfig.tsbuildinfo` is TypeScript's incremental-build cache. It was
# committed, so every build left the working tree dirty with a file that
# is machine-specific and carries no review value -- and a dirty tree is
# how real changes get lost at session close.
apps/web/tsconfig.tsbuildinfo

# `wrangler pages dev` writes a local cache here. Local runtime state.
.wrangler/

# Scratch space for review diffs and one-off logs. Session artefacts, not
# source -- `tmp/live_smoke_test_*.py`-style keepers should be moved to
# scripts/ deliberately rather than swept in by `git add .`.
tmp/

# Stored documents. The object store's filesystem adapter writes here by
# default (app/core/object_storage.py::default_object_store_root), and it holds
# uploaded SDS/TDS/CoA files. Committed by accident on 2026-08-22 -- eleven
# seeded PDFs went into the index in one commit. Version control is not a
# document store: these are tenant data, they are reproducible by the seeder,
# and in a real deployment they would be proprietary hazard documentation.
apps/api/var/
