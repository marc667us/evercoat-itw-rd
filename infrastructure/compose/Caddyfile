# EvercoatITWRD APP — reverse proxy
#
# Only web, api and keycloak are reachable. PostgreSQL, Valkey, Garage and
# (later) Ollama stay on the internal network and are never proxied — an
# object-storage endpoint exposed here would serve formulation documents
# without passing the authorization check that makes them safe to serve.

{
	# Local development. For a real deployment, remove this block and let
	# Caddy provision certificates automatically for the real hostnames.
	auto_https off
	admin off
}

:80 {
	encode gzip

	# 🔴 NO `uri strip_prefix /api` HERE. IT WAS THERE, AND IT WAS WRONG.
	#
	# FastAPI mounts every router UNDER `/api` itself —
	# `include_router(projects_router, prefix="/api/projects")` in
	# `apps/api/app/main.py` — and the web client asks for `/api/...`
	# unstripped; `apps/web/lib/api/client.test.ts` asserts the exact URL
	# `https://api.test/api/materials`.
	#
	# So stripping the prefix rewrote `/api/projects` to `/projects`,
	# which the API does not serve. EVERY API ROUTE WOULD HAVE 404'D
	# THROUGH THIS PROXY. It has not been noticed because the full compose
	# stack has never been up at once (see `CLAUDE.md` §15), and CI talks
	# to uvicorn directly rather than through Caddy.
	#
	# The `/auth` block below DOES strip, correctly: Keycloak serves
	# `/realms/...` at its root. The rule was copied to a service where
	# the opposite is true.
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Health is proxied so a probe can reach it. Liveness and readiness
	# disclose nothing and must answer.
	handle /health/* {
		reverse_proxy api:8000
	}

	# 🔴 METRICS ARE REFUSED AT THE EDGE, NOT MERELY UNROUTED.
	#
	# The comment here used to say metrics were "proxied but not published
	# beyond the edge network" — and no `/metrics` handler existed at all,
	# so the claim described nothing. Worse, while `/api/*` stripped its
	# prefix, `/api/metrics` was rewritten to `/metrics` and reached the
	# API's UNAUTHENTICATED Prometheus endpoint from the internet, which is
	# the exact opposite of what the comment promised.
	#
	# `/metrics` carries request counts and latencies for every route
	# template. That is reconnaissance — it tells an outsider which
	# endpoints exist and which are being exercised — so it is answered
	# with a flat refusal here and scraped over the internal network
	# instead.
	handle /metrics* {
		respond 404
	}

	# Identity
	handle /auth/* {
		uri strip_prefix /auth
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Everything else is the Next.js app
	handle {
		reverse_proxy web:3000
	}

	# 🔴 I110. THREE OF THE FIVE HEADERS `SECURITY.md` CLAIMED WERE HERE, AND
	# THE DEPLOYED SITE SENT NONE OF THEM — because the demonstration tunnel is
	# fronted by `Caddyfile.tunnel`, which had no `header` block at all. A
	# control written in the file nobody is running is not a control.
	#
	# ⚠️ THIS BLOCK IS DUPLICATED IN `Caddyfile.tunnel` ON PURPOSE. That file
	# fronts services on the HOST rather than in compose, is mounted standalone
	# into its container, and cannot `import` a file that is not mounted with
	# it. Two literals in two files cannot be type-checked into agreement, so
	# `tests/test_reverse_proxy_contract.py` asserts they are EQUAL.
	header {
		# max-age one year. Browsers ignore HSTS over plain HTTP, so this is
		# inert on the local `:80` stack and live behind the tunnel's TLS —
		# which is the correct behaviour in both places rather than a
		# compromise for either.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Nothing in this application uses a camera, a microphone or geolocation.
		# Saying so is cheaper than auditing later whether something started to.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# 🔴 THERE IS DELIBERATELY NO `script-src` HERE, AND THAT IS THE HONEST
		# ANSWER RATHER THAN THE COMFORTABLE ONE.
		#
		# `SECURITY.md` asked for "a Content-Security-Policy without
		# `unsafe-inline` scripts". Measured on this build: the pages emit
		# **13 inline `<script>` blocks** and **13 of 13 routes are
		# PRERENDERED** (`○ Static` / `● SSG`, zero `ƒ Dynamic`). A nonce is
		# per-request; prerendered HTML is written at build time and cannot
		# carry one. So the two available `script-src` values are:
		#
		#   'self' 'unsafe-inline'  — ships, enforces nothing about scripts,
		#                             and makes the document true while the
		#                             control is worthless;
		#   'self' + nonce          — blocks every inline script on every
		#                             prerendered page, i.e. a blank app.
		#
		# Neither is shipped. What IS below are the four directives that are
		# fully enforced, cost nothing, and are unrelated to inline scripts:
		# clickjacking, base-tag injection, form hijacking and plugin
		# embedding. They are real today.
		#
		# Closing the script half means opting the app into dynamic rendering
		# so Next.js can stamp a nonce — a real architectural change with a
		# real cost, recorded as **I116** rather than guessed at here.
		# `SECURITY.md` §13 now states what is enforced instead of what was
		# hoped for.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		-Server
	}

	log {
		output stdout
		format json
	}
}
