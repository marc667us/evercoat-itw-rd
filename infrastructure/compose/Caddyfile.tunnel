# Reverse proxy for the LOCAL DEMONSTRATION TUNNEL.
#
# NOT `infrastructure/compose/Caddyfile`. That one fronts services running
# inside compose; this one fronts the API and web running on the HOST, so the
# whole stack does not have to be built on a machine with 1.6 GB free.
#
# 🔴 WHY THIS FILE IS IN THE REPOSITORY.
#
# It used to live in a session scratchpad under
# `AppData/Local/Temp/claude/<session-id>/scratchpad/proxy/`, mounted into the
# container from there. That directory belongs to a single Claude session and
# is cleaned up; the running container held the only copy, so the demonstration
# tunnel could not be rebuilt from the repository by anyone, including the next
# session. A demo whose configuration exists only inside a running container is
# one power cut from being unreproducible.
#
# Usage:
#
#   docker run -d --name evercoat-demo-caddy -p 18081:80 \
#     --add-host host.docker.internal:host-gateway \
#     -v "<repo>/infrastructure/compose/Caddyfile.tunnel:/etc/caddy/Caddyfile:ro" \
#     caddy:2-alpine
#
#   npx localtunnel --port 18081 --subdomain evercoat-itwrd
#
# Everything reaches the client on ONE origin, which is what makes browser
# PKCE work: the token issuer, the API and the page are same-origin, so there
# is no CORS negotiation and no third-party cookie question.

{
	auto_https off
	admin off
}

:80 {
	encode gzip

	# 🔴 I110 — THIS FILE IS WHY THE DEPLOYED SITE SENT NO SECURITY HEADERS AT
	# ALL.
	#
	# `SECURITY.md:234` claimed five, the repository's own `Caddyfile` carried
	# three of them, and THIS file — the one actually in front of the
	# demonstration tunnel — had no `header` block whatsoever. `curl -D -`
	# against the deployed site returned none of the five, on 2026-08-31 and
	# again on 2026-09-01. A control written in a file nobody is running is not
	# a control, and the file being run is the one that decides.
	#
	# ⚠️ IDENTICAL TO THE BLOCK IN `Caddyfile`, ON PURPOSE, AND ASSERTED EQUAL.
	# This file fronts services on the HOST and is mounted standalone into its
	# container, so it cannot `import` a file that is not mounted beside it.
	# Two literals in two files cannot be type-checked into agreement, so
	# `tests/test_reverse_proxy_contract.py` compares them.
	#
	# 🔴 AND THERE IS DELIBERATELY NO `script-src`. Measured: 13 inline
	# `<script>` blocks, and 13 of 13 routes PRERENDERED. A nonce is
	# per-request and prerendered HTML cannot carry one, so `'unsafe-inline'`
	# would make the document true while enforcing nothing, and a nonce would
	# blank the app. The four directives below are fully enforced and unrelated
	# to inline scripts. The script half is **I116**.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# FastAPI mounts every router UNDER /api itself, so stripping the prefix
	# here would 404 every route. Same rule as the repo's own Caddyfile.
	handle /api/* {
		reverse_proxy host.docker.internal:18000
	}

	# 🔴 ADDED 2026-08-23. Without this the health endpoints fell through to
	# Next.js, which answered 404 — and `scripts/live-suite.sh` waits on
	# `/health/ready` before it will run anything at all. It polled for the
	# full 300 seconds and reported `passed=0 failed=0 skipped=0 (suite did
	# not run)` against a stack that was entirely healthy.
	#
	# That is the three-number contract doing exactly its job: an exit code
	# would have said "failed" and sent the next reader looking for an outage.
	# The API was fine; the PROXY had no route to the probe.
	handle /health/* {
		reverse_proxy host.docker.internal:18000
	}

	handle /docs* {
		reverse_proxy host.docker.internal:18000
	}
	handle /openapi.json {
		reverse_proxy host.docker.internal:18000
	}

	# 🔴 THE APPLICATION'S OWN CALLBACK LIVES UNDER /auth AND MUST BE MATCHED
	# FIRST, OR THE IDENTITY PROXY BELOW SWALLOWS IT.
	#
	# `lib/auth/config.ts` sets `CALLBACK_PATH = "/auth/callback/"`, there is a
	# real page at `app/auth/callback/page.tsx`, and that exact URL is what the
	# realm has registered as the redirect URI. But the `/auth/*` rule below
	# strips the prefix and forwards to Keycloak -- so Keycloak was asked for
	# `/callback/`, answered 404, and **every browser sign-in ended on a 404
	# page after authenticating successfully**.
	#
	# Measured: `:3000/auth/callback` -> 200, `:18081/auth/callback/` -> 404.
	# The application was fine; the PROXY had no route to it. The same shape as
	# the `/health/*` fall-through fixed on 2026-08-23, one directory along.
	#
	# ⚠️ This never showed up before because the demo had only ever been driven
	# by DIRECT GRANT tokens (`evercoat-test`), which never touch the callback.
	# The browser flow -- the one a human actually uses -- was unexercised.
	handle /auth/callback* {
		reverse_proxy host.docker.internal:3000
	}

	# Identity. Strip the prefix, because Keycloak serves /realms/... at its
	# root and is told its public base is <tunnel>/auth via KC_HOSTNAME.
	handle /auth/* {
		uri strip_prefix /auth
		reverse_proxy host.docker.internal:18080 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		reverse_proxy host.docker.internal:3000
	}
}
